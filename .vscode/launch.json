{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Current File",
      "type": "node",
      "request": "launch",
      "program": "${file}"
    },
    {
      "name": "Tape-ES (Test)",
      "type": "node",
      "request": "launch",
      "skipFiles": [
          "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/bin/tape-es.js",
      "cwd": "${userHome}/Code/vanillaes/csv",
      "console": "integratedTerminal",
  },
  {
      "name": "Tape-Watch-ES (Test)",
      "type": "node",
      "request": "launch",
      "skipFiles": [
          "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/bin/tape-watch-es.js",
      "args": ["-r", "${userHome}/Code/vanillaes/csv"],
      "console": "integratedTerminal",
  }
  ]
}
