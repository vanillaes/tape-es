{
  "name": "@vanillaes/tape-es",
  "version": "4.0.16",
  "description": "ESM-compatible Tape.js test runner",
  "keywords": [
    "testing",
    "esm",
    "esmodules",
    "tape",
    "nodejs",
    "cli"
  ],
  "repository": "https://github.com/vanillaes/tape-es",
  "author": "Evan Plaice <evanplaice@gmail.com> (http://evanplaice.com/)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tape-es": "bin/tape-es.js"
  },
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./src/index.d.ts"
    }
  },
  "scripts": {
    "tape-es": "node ./bin/tape-es.js",
    "test": "esmtk test",
    "lint": "esmtk lint",
    "type": "esmtk type --strict --types node && esmtk type --strict --types node ./bin/tape-es.js",
    "build": "esmtk typings --types node",
    "clean": "esmtk clean --typings",
    "preview": "esmtk preview",
    "preversion": "npm run test && npm run lint && npm run type",
    "version": "npm run clean && npm run build && git add **/*.d.ts",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "@vanillaes/esmtk": "^2.4.0",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "tape": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0"
  }
}
