{
  "name": "@vanillaes/tape-es",
  "version": "4.0.0",
  "description": "ESM-compatible Tape.js test runner",
  "keywords": [
    "testing",
    "esm",
    "esmodules",
    "tape",
    "nodejs",
    "cli"
  ],
  "repository": "https://github.com/vanillaes/tape-es",
  "author": "Evan Plaice <evanplaice@gmail.com> (http://evanplaice.com/)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tape-es": "bin/tape-es.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "lint": "esmtk lint",
    "types": "esmtk types ./src/index.js",
    "package": "npx rimraf package && npm pack | tail -n 1 | xargs tar -xf",
    "preversion": "npm run lint",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "tape": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vanillaes/esmtk": "^0.9.0"
  }
}
