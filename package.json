{
  "name": "@vanillaes/tape-es",
  "version": "4.0.8",
  "description": "ESM-compatible Tape.js test runner",
  "keywords": [
    "testing",
    "esm",
    "esmodules",
    "tape",
    "nodejs",
    "cli"
  ],
  "repository": "https://github.com/vanillaes/tape-es",
  "author": "Evan Plaice <evanplaice@gmail.com> (http://evanplaice.com/)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tape-es": "bin/tape-es.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "lint": "esmtk lint",
    "test": "esmtk test",
    "type": "esmtk type --types node ./src/index.js",
    "preview": "esmtk preview",
    "preversion": "npm run lint && npm run test && npm run type",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "tape": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vanillaes/esmtk": "^1.2.2"
  }
}
